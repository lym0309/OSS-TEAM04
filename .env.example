# docker compose 용 환경변수 (cp .env.example .env)
# ⚠️ .env는 커밋 금지

DB_ROOT_PASSWORD=change-me-root
DB_NAME=zupzup
DB_USER=oss
DB_PASSWORD=change-me

# 내 PC에서 3306/3000 포트가 이미 사용 중이면 바꾸기 (backend/.env의 DB_PORT도 같이)
DB_HOST_PORT=3306
BACKEND_HOST_PORT=3000

# 허용할 프론트 주소 (쉼표로 구분)
CORS_ORIGIN=http://localhost:5173

# 경찰청 습득물 API 인증키
POLICE_API_KEY=
# 경찰청 포털기관(공공기관) 습득물 API 인증키
POLICE_PT_API_KEY=

# 습득물 주기 수집 (서버 실행 중 자동). 끄려면 false
COLLECT_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
COLLECT_DAYS=30
