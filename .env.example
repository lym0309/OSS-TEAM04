# docker compose 용 환경변수 (cp .env.example .env)
# ⚠️ .env는 커밋 금지

DB_ROOT_PASSWORD=change-me-root
DB_NAME=lostfound
DB_USER=oss
DB_PASSWORD=change-me

# 내 PC에서 3306/3000 포트가 이미 사용 중이면 바꾸기 (backend/.env의 DB_PORT도 같이)
DB_HOST_PORT=3306
BACKEND_HOST_PORT=3000

# 허용할 프론트 주소 (쉼표로 구분)
CORS_ORIGIN=http://localhost:5173

# 경찰청 습득물 API 인증키
POLICE_API_KEY=
