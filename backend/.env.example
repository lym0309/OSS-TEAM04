# 로컬에서 `npm run dev`로 서버를 띄울 때 사용 (cp .env.example .env)
# ⚠️ .env는 커밋 금지

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL (docker compose up -d mysql 로 띄운 로컬 DB 기준)
DB_HOST=localhost
DB_PORT=3306
DB_USER=oss
DB_PASSWORD=change-me
DB_NAME=lostfound

# 경찰청 습득물 API (공공데이터포털 > 마이페이지 > 일반 인증키)
POLICE_API_KEY=
